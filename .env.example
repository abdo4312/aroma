# Backend API (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:3000/api

# Demo mode: accepts any email/password and never calls a real backend.
# Enabled here so the showcase runs without a backend. Set to false for the real API.
VITE_USE_MOCK=true

# Optional feature flags
VITE_FEATURE_GOLDEN_HOUR=true
VITE_FEATURE_BUILD_YOUR_BOX=true
VITE_FEATURE_CONSULTATION=true
